genrule {
    name: "gen_firmware_scripts",
    srcs: [
        "firmware.sh.in",
        "tee.sh.in",
    ],
    out: [
        "firmware.sh",
        "tee.sh",
    ],
    cmd: "for f in $(in); do " +
         "  out=$(genDir)/\"$$(basename \"$$f\" .in)\"; " +
         "  sed 's/modem/" + select(soong_config_variable("s5e9925", "modem_partition"), {
             any @ val: val,
             default: "sda17",
         }) + "/g' \"$$f\" > \"$$out\"; " +
         "done",
}

prebuilt_etc {
    name: "fstab.s5e9925",
    src: "fstab.s5e9925",
    vendor: true,
}

prebuilt_root {
    name: "fstab.s5e9925.vendor_ramdisk",
    src: "fstab.s5e9925",
    filename_from_src: true,
    vendor_ramdisk: true,
    install_in_root: true,
}

prebuilt_etc {
    name: "init.s5e9925.rc",
    relative_install_path: "init",
    src: "init.s5e9925.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e9925.rgb.rc",
    relative_install_path: "init",
    src: "init.s5e9925.rgb.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e9925.usb.rc",
    relative_install_path: "init",
    src: "init.s5e9925.usb.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.fingerprint.rc",
    relative_install_path: "init",
    src: "init.fingerprint.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.samsung.rc",
    relative_install_path: "init",
    src: "init.samsung.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.tsp.rc",
    relative_install_path: "init",
    src: "init.tsp.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.gps.rc",
    relative_install_path: "init",
    src: "init.gps.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.s5e9925.rc",
    recovery: true,
    relative_install_path: "init",
    src: "init.recovery.s5e9925.rc",
}

prebuilt_etc {
    name: "ueventd.s5e9925.rc",
    filename: "ueventd.rc",
    src: "ueventd.s5e9925.rc",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e9925.tee.rc",
    relative_install_path: "init",
    src: "init.s5e9925.tee.rc",
    vendor: true,
}

sh_binary {
    name: "tee.sh",
    src: ":gen_firmware_scripts{tee.sh}",
    vendor: true,
}

sh_binary {
    name: "firmware.sh",
    src: ":gen_firmware_scripts{firmware.sh}",
    recovery: true,
}
