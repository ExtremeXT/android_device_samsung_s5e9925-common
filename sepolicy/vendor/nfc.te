allow nfc vendor_hal_nxpnfc_service:service_manager find;

allow nfc nfc_vendor_data_file:dir rw_dir_perms;
allow nfc nfc_vendor_data_file:file create_file_perms;

dontaudit nfc system_data_file:dir rw_dir_perms;
dontaudit nfc system_data_file:file create_file_perms;
