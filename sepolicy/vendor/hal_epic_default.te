type hal_vendor_epic_service, service_manager_type;
type hal_vendor_epic_service_default, domain;
type hal_vendor_epic_service_default_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(hal_vendor_epic_service_default)

allow hal_vendor_epic_service_default hal_vendor_epic_service:service_manager { add find };
allow hal_vendor_epic_service_default servicemanager:binder { call transfer };
allow hal_vendor_epic_service_default servicemanager:fd use;

allow hal_vendor_epic_service_default epicd_socket:sock_file { write setattr };
allow hal_vendor_epic_service_default epicd_socket:unix_dgram_socket sendto;
allow hal_vendor_epic_service_default epicd_socket:unix_stream_socket write;

vndbinder_use(hal_vendor_epic_service_default)

allow system_server hal_vendor_epic_service:service_manager find;
allow system_server hal_vendor_epic_service_default:binder call;

allow system_server epic_service:service_manager add;
