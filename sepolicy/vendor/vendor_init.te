allow vendor_init cgroup:file getattr;

get_prop(vendor_init, vendor_radio_prop);
dontaudit vendor_init system_prop:file read;

allow vendor_init tmpfs:dir rw_dir_perms;
allow vendor_init tmpfs:lnk_file create_file_perms;

allow vendor_init proc_swappiness:file rw_file_perms;
allow vendor_init proc_dirty_background_bytes:file rw_file_perms;
allow vendor_init proc_dirty_bytes:file rw_file_perms;
allow vendor_init proc_sched:file rw_file_perms;

allow vendor_init cpdebug_efs_file:lnk_file getattr;
allow vendor_init ssm_efs_file:file getattr;

get_prop(vendor_init, vts_status_prop)
set_prop(vendor_init, vendor_cbd_prop)
set_prop(vendor_init, vendor_hwc_prop)
set_prop(vendor_init, vendor_sec_nfc_prop)
set_prop(vendor_init, vendor_securehw_prop)
set_prop(vendor_init, vendor_securenvm_prop)
set_prop(vendor_init, vendor_power_prop)

dontaudit vendor_init { default_prop system_prop build_prop }:property_service set;

allow vendor_init efs_file:dir rw_dir_perms;
