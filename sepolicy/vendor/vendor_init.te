allow vendor_init cgroup:file rw_file_perms;
allow vendor_init proc_bootconfig:file r_file_perms;
allow vendor_init proc_sched:file rw_file_perms;
allow vendor_init range_sensor_data_file:dir rw_dir_perms;
allow vendor_init range_sensor_data_file:file rw_file_perms;
allow vendor_init tmpfs:dir rw_dir_perms;
get_prop(vendor_init, vendor_radio_prop)
get_prop(vendor_init, vts_status_prop)
set_prop(vendor_init, vendor_securehw_prop)
set_prop(vendor_init, vendor_securenvm_prop)
