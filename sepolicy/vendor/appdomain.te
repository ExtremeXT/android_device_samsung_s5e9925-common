allow appdomain sysfs_gpu:dir r_dir_perms;

# Hide QCOM camera prop denials
dontaudit appdomain vendor_camera_prop:file r_file_perms;

# Hide spammy AVC
dontaudit isolated_app content_capture_service:service_manager find;
