allow hal_nfc_default nfc_vendor_data_file:dir create_dir_perms;
allow hal_nfc_default nfc_vendor_data_file:file create_file_perms;

# Allow NFC HAL to use nfc devices
allow hal_nfc_default nfc_device:chr_file rw_file_perms;

allow hal_nfc_default vendor_hal_nxpnfc_service:service_manager { find add };

# Allow NFC HAL to read NFC properties
get_prop(hal_nfc_default, vendor_sec_nfc_prop)
