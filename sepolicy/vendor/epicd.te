allow epicd sysfs_gpu:file { read write getattr open };
allow epicd sysfs_gpu:dir search;
allow epicd ems_file:file rw_file_perms;
allow epicd sysfs_power_writable:file rw_file_perms;
allow epicd self:netlink_kobject_uevent_socket { create bind read };
allow epicd migov_device:chr_file rw_file_perms;
allow epicd migov_file:file rw_file_perms;
allow epicd sysfs:file { open write };

dontaudit epicd device:chr_file { ioctl open read write };
